# Environment Configuration
NODE_ENV=development
FRONTEND_PORT=3000

# Base path ของ API ที่ browser เรียก (nginx/vite จะ proxy ต่อไปยัง backend)
VITE_API_BASE_URL=/api

# ใช้เฉพาะตอน docker compose.dev (vite proxy target)
VITE_API_PROXY=http://api:8000

# Cesium ion access token (Bing Aerial basemap) — ว่างไว้ = ใช้ Esri
VITE_CESIUM_ION_TOKEN=
