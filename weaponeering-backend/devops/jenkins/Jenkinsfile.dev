pipeline {
    options {
        timeout(time: 60, unit: 'MINUTES')
        timestamps()
        disableConcurrentBuilds()
    }

    agent {
        kubernetes {
            cloud 'kubernetes-prod'
            yaml '''
            apiVersion: v1
            kind: Pod
            spec:
              dnsPolicy: "ClusterFirst"
              containers:
              - name: python
                image: docker.io/python:3.12.9-slim
                command:
                - cat
                tty: true
                env:
                - name: TZ
                  value: Asia/Bangkok
              - name: k8s
                image: gcr.io/cloud-builders/kubectl
                command:
                - cat
                tty: true
                env:
                - name: TZ
                  value: Asia/Bangkok
              - name: docker
                image: docker.io/docker:24.0.9-cli
                command: ["cat"]
                tty: true
                securityContext:
                  privileged: true
                env:
                - name: TZ
                  value: Asia/Bangkok
                volumeMounts:
                - mountPath: /var/run/docker.sock
                  name: docker-sock
              - name: owasp
                image: ghcr.io/zaproxy/zaproxy:latest
                command: ["cat"]
                tty: true
                env:
                - name: TZ
                  value: Asia/Bangkok
                volumeMounts:
                - mountPath: /zap/wrk
                  name: report-storage
              volumes:
              - name: docker-sock
                hostPath:
                  path: /var/run/docker.sock
                  type: Socket
              - name: report-storage
                emptyDir: {}
            '''
        }
    }

    environment {
        PROJECT_DIR = 'weaponeering-backend'
        IMAGE_NAME = 'weaponeering-backend-uat'
        NAMESPACE = 'weaponeering-backend-uat'
        HOST_NAME = 'weaponeering-api-uat.rtaf.mi.th'
        CONTAINER_PORT = '8000'
        TCP_PORT = '80'
        SECRETS = 'weaponeering-backend-uat-secret'
        CONFIG_MAP = 'weaponeering-backend-uat-config'
        KUBERNETES_MANIFEST = 'weaponeering-backend/devops/kubernetes/deployment.yaml'
        SONAR_PROJECT_KEY = 'weaponeering_backend_api'
        SCANNER_HOME = tool 'SonarScanner'
        CLUSTER_CREDENTIALS = 'rancher-prod-01'
        DOCKER_IMAGE_NAME = ''
        GIT_HEAD = ''
        PROJECT_ROOT = ''
        FIXED_VERSION = '1.0'
    }

    stages {
        stage('Build job setting up') {
            steps {
                script {
                    sh 'export TZ=Asia/Bangkok'
                    def initialDailyVersion = 0
                    try {
                        if (params.DAILY_IMAGE_VERSION != null && params.DAILY_IMAGE_VERSION.isNumber()) {
                            initialDailyVersion = params.DAILY_IMAGE_VERSION.toInteger()
                        } else {
                            echo("DAILY_IMAGE_VERSION parameter is missing or not a number, defaulting to 0.")
                        }
                    } catch (Exception e) {
                        echo("Could not read DAILY_IMAGE_VERSION from parameters, assuming 0. Exception: ${e}")
                        initialDailyVersion = 0
                    }
                    echo "Initial DAILY_IMAGE_VERSION parameter read as: ${initialDailyVersion}"

                    def previousBuild = currentBuild.getPreviousBuild()
                    def currentBuildDate = new Date(currentBuild.startTimeInMillis).format('yyyyMMdd')
                    def previousBuildDate = ""
                    def calculatedDailyVersion = 1

                    if (previousBuild == null) {
                        echo "This is the first build."
                        previousBuildDate = currentBuildDate
                    } else {
                        echo "Previous build found (#${previousBuild.number})."
                        previousBuildDate = new Date(previousBuild.startTimeInMillis).format('yyyyMMdd')
                        echo "Previous build date is ${previousBuildDate}"
                        echo "Current build date is ${currentBuildDate}"

                        if (currentBuildDate == previousBuildDate) {
                            calculatedDailyVersion = initialDailyVersion + 1
                        }
                    }

                    echo "Calculated daily version for this build is: ${calculatedDailyVersion}"

                    def dailyVersionString = String.format('%02d', calculatedDailyVersion)
                    FIXED_VERSION = params.FIXED_VERSION ?: '1.0'
                    env.BRANCH_NAME = params.BRANCH_NAME ?: env.BRANCH_NAME
                    def buildNumber = env.BUILD_NUMBER

                    DOCKER_IMAGE_NAME = "${FIXED_VERSION}-${buildNumber}-${currentBuildDate}.${dailyVersionString}"

                    echo "BRANCH_NAME for this build is ${env.BRANCH_NAME}"
                    echo "Build number is ${env.BUILD_NUMBER} and image version is ${DOCKER_IMAGE_NAME}"
                }
            }
        }

        stage('Git clone and Setup') {
            steps {
                script {
                    deleteDir()
                    checkout scm
                    GIT_HEAD = sh(returnStdout: true, script: 'git rev-parse --short HEAD').trim()
                    if (fileExists("${PROJECT_DIR}/Dockerfile")) {
                        PROJECT_ROOT = PROJECT_DIR
                    } else if (fileExists('Dockerfile')) {
                        PROJECT_ROOT = '.'
                    } else {
                        error("Dockerfile not found in ${PROJECT_DIR}/ or workspace root")
                    }
                    KUBERNETES_MANIFEST = "${PROJECT_ROOT}/devops/kubernetes/deployment.yaml"
                    echo "PROJECT_ROOT=${PROJECT_ROOT}"
                    echo "GIT_HEAD=${GIT_HEAD}"
                    echo "Branch for build is ${env.BRANCH_NAME}"
                }
            }
        }

        stage('SonarQube Analysis') {
            when {
                expression {
                    params.SKIP_SONAR_SCAN != true
                }
            }
            steps {
                dir("${PROJECT_ROOT}") {
                    script {
                        withSonarQubeEnv('SonarScanner') {
                            sh """${SCANNER_HOME}/bin/sonar-scanner \
                                -Dsonar.projectKey=${SONAR_PROJECT_KEY} \
                                -Dsonar.host.url=https://${env.SONAR_URL} \
                                -Dsonar.projectVersion=${DOCKER_IMAGE_NAME} \
                                -Dsonar.sources=src/weaponeering_api,src/maap_app \
                                -Dsonar.tests=tests \
                                -Dsonar.python.version=3.12"""
                        }
                    }
                }
            }
        }

        stage('SonarQube Quality Gate Check') {
            when {
                expression {
                    params.SKIP_SONAR_SCAN != true
                }
            }
            steps {
                container('docker') {
                    script {
                        timeout(time: 3600, unit: 'SECONDS') {
                            def qg = waitForQualityGate()
                            echo "Status is ${qg.status}"
                            if (qg.status != 'OK') {
                                currentBuild.result = 'FAILURE'
                                error('SonarQube Quality Gates Fail')
                            } else {
                                echo 'SonarQube Quality Gates Success'
                            }
                        }
                    }
                }
            }
        }

        stage('Unit Test') {
            when {
                expression {
                    params.SKIP_UNIT_TEST != true
                }
            }
            steps {
                container('python') {
                    dir("${PROJECT_ROOT}") {
                        sh '''
                            pip install --no-cache-dir -r requirements-api.txt -r requirements.txt
                            PYTHONPATH=src pytest tests/unit -q
                        '''
                    }
                }
            }
        }

        stage('Build image') {
            when {
                expression {
                    params.SKIP_BUILD_IMAGE != true
                }
            }
            steps {
                container('docker') {
                    script {
                        sh """
                            docker build --no-cache \
                                -f ${PROJECT_ROOT}/Dockerfile \
                                --build-arg APP_VERSION=${DOCKER_IMAGE_NAME} \
                                --build-arg GIT_COMMIT=${GIT_HEAD} \
                                --build-arg GIT_BRANCH=${env.BRANCH_NAME} \
                                --build-arg BUILD_DATE=\$(date -u +%Y-%m-%dT%H:%M:%SZ) \
                                --build-arg BUILD_NUMBER=${BUILD_NUMBER} \
                                -t ${IMAGE_NAME}:${DOCKER_IMAGE_NAME} \
                                ${PROJECT_ROOT}
                            docker tag ${IMAGE_NAME}:${DOCKER_IMAGE_NAME} ${env.REGISTRY_URL}/${IMAGE_NAME}:${DOCKER_IMAGE_NAME}
                        """
                    }
                }
            }
        }

        stage('Image scan (Trivy)') {
            when {
                expression {
                    params.SKIP_TRIVY_SCAN != true
                }
            }
            steps {
                container('docker') {
                    script {
                        def trivyVersion = sh(
                            script: '''
                                wget -qO - "https://api.github.com/repos/aquasecurity/trivy/releases/latest" | grep '"tag_name":' | sed -E 's/.*"v([^"]+)".*/\\1/'
                            ''',
                            returnStdout: true
                        ).trim()
                        echo "Latest Trivy version: ${trivyVersion}"
                        sh(script: "wget --no-verbose https://github.com/aquasecurity/trivy/releases/download/v${trivyVersion}/trivy_${trivyVersion}_Linux-64bit.tar.gz -O - | tar -zxvf -", returnStdout: true).trim()
                        sh """
                            ./trivy image --no-progress --scanners vuln --format template --template "@contrib/html.tpl" -o trivy-${IMAGE_NAME}-${DOCKER_IMAGE_NAME}-report.html ${IMAGE_NAME}:${DOCKER_IMAGE_NAME}
                        """
                    }
                }
            }
        }

        stage('Push image to Nexus') {
            when {
                expression {
                    params.SKIP_PUSH_IMAGE != true
                }
            }
            steps {
                container('docker') {
                    withCredentials([usernamePassword(credentialsId: "${env.REGISTRY_CREDENTIALS}", usernameVariable: 'USERNAME', passwordVariable: 'PASSWORD')]) {
                        sh "docker login ${env.REGISTRY_URL} --username ${USERNAME} --password ${PASSWORD}"
                        sh "docker push ${env.REGISTRY_URL}/${IMAGE_NAME}:${DOCKER_IMAGE_NAME}"
                    }
                }
            }
        }

        stage('Deploy to Kubernetes Dev Env') {
            when {
                expression {
                    params.SKIP_DEPLOY != true
                }
            }
            steps {
                container('k8s') {
                    script {
                        def pullSecret = env.PULL_SECRET
                        def namespaceManifest = "${PROJECT_ROOT}/devops/kubernetes/namespace-dev.yaml"
                        withCredentials([
                            file(credentialsId: "${CLUSTER_CREDENTIALS}", variable: 'KUBECONFIG'),
                            usernamePassword(credentialsId: "${env.REGISTRY_CREDENTIALS}", usernameVariable: 'REGISTRY_USER', passwordVariable: 'REGISTRY_PASS')
                        ]) {
                            sh 'kubectl get nodes'

                            sh """
                            # Namespace ${NAMESPACE} already exists on prod-01 / project swc-strategic
                            kubectl get namespace ${NAMESPACE}
                            if [ -f ${namespaceManifest} ]; then
                              kubectl apply -f ${namespaceManifest}
                            fi

                            kubectl -n ${NAMESPACE} create secret docker-registry ${pullSecret} \
                                --docker-server=${env.REGISTRY_URL} \
                                --docker-username=\${REGISTRY_USER} \
                                --docker-password=\${REGISTRY_PASS} \
                                --dry-run=client -o yaml | kubectl apply -f -

                            if ! kubectl -n ${NAMESPACE} get secret ${SECRETS} >/dev/null 2>&1; then
                              echo "WARNING: Secret ${SECRETS} not found — copy DB credentials into UAT namespace"
                            fi

                            sed -e "s|{{NAMESPACE}}|${NAMESPACE}|g" \
                                -e "s|{{HOST_NAME}}|${HOST_NAME}|g" \
                                -e "s|{{PULL_IMAGE}}|${env.REGISTRY_URL}/${IMAGE_NAME}:${DOCKER_IMAGE_NAME}|g" \
                                -e "s|{{PULL_SECRET}}|${pullSecret}|g" \
                                -e "s|{{IMAGE_NAME}}|${IMAGE_NAME}|g" \
                                -e "s|{{CONTAINER_PORT}}|${CONTAINER_PORT}|g" \
                                -e "s|{{TCP_PORT}}|${TCP_PORT}|g" \
                                -e "s|{{SECRETS}}|${SECRETS}|g" \
                                -e "s|{{CONFIG_MAP}}|${CONFIG_MAP}|g" \
                                ${KUBERNETES_MANIFEST} | kubectl apply -f -

                            kubectl -n ${NAMESPACE} rollout status deployment/${IMAGE_NAME}-deployment --timeout=600s
                            """
                        }
                    }
                }
            }
        }

        stage('Scanning target on OWASP') {
            when {
                expression {
                    params.SKIP_OWASP_SCAN != true
                }
            }
            steps {
                container('owasp') {
                    script {
                        def scan_type = "${params.SCAN_TYPE}"
                        echo "----> scan_type: $scan_type"
                        def target = "http://${IMAGE_NAME}-service.${NAMESPACE}.svc.cluster.local:${TCP_PORT}"
                        echo "----> target: $target"
                        if (scan_type == 'Baseline') {
                            sh """
                            zap-baseline.py \
                            -t $target \
                            -r report.html \
                            -I
                        """
                        } else if (scan_type == 'APIS') {
                            sh """
                            zap-api-scan.py \
                            -t $target/openapi.json \
                            -r report.html \
                            -I || zap-baseline.py -t $target -r report.html -I
                        """
                        } else if (scan_type == 'Full') {
                            sh """
                            zap-full-scan.py \
                            -t $target \
                            -r report.html \
                            -I
                        """
                        } else {
                            echo 'Something went wrong...'
                        }
                        sh "cp -r /zap/wrk/report.html ${WORKSPACE}/owasp-zap-${IMAGE_NAME}-${DOCKER_IMAGE_NAME}-report.html"
                    }
                }
            }
        }
    }

    post {
        success {
            container('jnlp') {
                script {
                    echo "Pipeline successful. Updating job parameters for next build."

                    def nextDailyVersion = 1
                    def currentBuildDateForPost = new Date(currentBuild.startTimeInMillis).format('yyyyMMdd')
                    def previousBuildForPost = currentBuild.getPreviousBuild()

                    if (previousBuildForPost != null) {
                        def previousBuildDateForPost = new Date(previousBuildForPost.startTimeInMillis).format('yyyyMMdd')
                        if (currentBuildDateForPost == previousBuildDateForPost) {
                            def tempInitial = 0
                            try {
                                if (params.DAILY_IMAGE_VERSION != null && params.DAILY_IMAGE_VERSION.isNumber()) {
                                    tempInitial = params.DAILY_IMAGE_VERSION.toInteger()
                                }
                            } catch (e) { /* ignore */ }
                            nextDailyVersion = tempInitial + 1
                        }
                    }

                    echo "Setting DAILY_IMAGE_VERSION parameter for next build to: ${nextDailyVersion}"

                    properties([
                        parameters([
                            string(defaultValue: "${nextDailyVersion}", description: 'Daily image version number (reset every day)', name: 'DAILY_IMAGE_VERSION', trim: true),
                            string(defaultValue: "${env.BRANCH_NAME}", description: '', name: 'BRANCH_NAME', trim: true),
                            string(defaultValue: "${FIXED_VERSION}", description: '', name: 'FIXED_VERSION', trim: true),
                            booleanParam(defaultValue: params.SKIP_SONAR_SCAN ?: false, description: 'Skip Sonar Analysis stage', name: 'SKIP_SONAR_SCAN'),
                            booleanParam(defaultValue: params.SKIP_UNIT_TEST ?: false, description: 'Skip Unit Test stage', name: 'SKIP_UNIT_TEST'),
                            booleanParam(defaultValue: params.SKIP_BUILD_IMAGE ?: false, description: 'Skip Build image stage', name: 'SKIP_BUILD_IMAGE'),
                            booleanParam(defaultValue: params.SKIP_TRIVY_SCAN ?: false, description: 'Skip Image scan (Trivy) stage', name: 'SKIP_TRIVY_SCAN'),
                            booleanParam(defaultValue: params.SKIP_PUSH_IMAGE ?: false, description: 'Skip Push image to Nexus stage', name: 'SKIP_PUSH_IMAGE'),
                            booleanParam(defaultValue: params.SKIP_DEPLOY ?: false, description: 'Skip Deploy to Kubernetes stage', name: 'SKIP_DEPLOY'),
                            booleanParam(defaultValue: params.SKIP_OWASP_SCAN ?: true, description: 'Skip OWASP scan stage', name: 'SKIP_OWASP_SCAN'),
                            choice(choices: ['Baseline', 'APIS', 'Full'], name: 'SCAN_TYPE', defaultValue: params.SCAN_TYPE ?: 'Baseline', description: 'Type of scan that is going to perform inside the container'),
                        ])
                    ])
                }
            }
        }
        failure {
            container('jnlp') {
                script {
                    echo "Pipeline failed. DAILY_IMAGE_VERSION parameter will not be updated."
                }
            }
        }
        aborted {
            container('jnlp') {
                script {
                    echo "Pipeline aborted. DAILY_IMAGE_VERSION parameter will not be updated."
                }
            }
        }
        always {
            container('jnlp') {
                archiveArtifacts artifacts: "trivy-${IMAGE_NAME}-${DOCKER_IMAGE_NAME}-report.html, owasp-zap-${IMAGE_NAME}-${DOCKER_IMAGE_NAME}-report.html", fingerprint: true, allowEmptyArchive: true
                publishHTML(target: [
                    allowMissing: true,
                    alwaysLinkToLastBuild: false,
                    keepAll: true,
                    reportDir: '.',
                    reportFiles: "trivy-${IMAGE_NAME}-${DOCKER_IMAGE_NAME}-report.html",
                    reportName: 'Trivy Scan Report'
                ])
                publishHTML(target: [
                    allowMissing: true,
                    alwaysLinkToLastBuild: false,
                    keepAll: true,
                    reportDir: '.',
                    reportFiles: "owasp-zap-${IMAGE_NAME}-${DOCKER_IMAGE_NAME}-report.html",
                    reportName: 'OWASP ZAP Scan Report'
                ])
            }
        }
    }
}
