# คัดลอกเป็น .env ก่อนรัน production: cp env.prod.example .env

# ── Database (pgpool) ────────────────────────────────────────────────────────
DB_HOST=pgpool
DB_PORT=5432
DB_NAME=weaponeering
DB_USER=your-db-user
DB_PASSWORD=your-db-password

# ── API ──────────────────────────────────────────────────────────────────────
APP_NAME=Weaponeering API
API_PREFIX=/api
CORS_ORIGINS=https://weaponeering.rtaf.mi.th,https://test-weaponeering.rtaf.mi.th
WORKERS=2

# ── RTAF MFA ─────────────────────────────────────────────────────────────────
RTAF_MFA_URL=https://apigw.rtaf.mi.th/login-rtaf-mfa/v2/mfa/login
RTAF_MFA_TIMEOUT_SECONDS=15
RTAF_MFA_VERIFY_SSL=false
