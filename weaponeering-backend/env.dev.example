# คัดลอกเป็น .env ก่อนรัน: cp env.dev.example .env

# ── Database (pgpool บน Docker ของเครื่อง) ───────────────────────────────────
DB_HOST=pgpool
DB_PORT=5432
DB_NAME=weaponeering
DB_USER=your-db-user
DB_PASSWORD=your-db-password

# ── API ──────────────────────────────────────────────────────────────────────
APP_NAME=Weaponeering API
API_PREFIX=/api
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# ── RTAF MFA ─────────────────────────────────────────────────────────────────
RTAF_MFA_URL=https://apigw.rtaf.mi.th/login-rtaf-mfa/v2/mfa/login
RTAF_MFA_TIMEOUT_SECONDS=15
# apigw ใช้ cert ภายใน — false ใน Docker/dev
RTAF_MFA_VERIFY_SSL=false

# ── Ports (ใช้ที่ root .env ของ compose ด้วยได้) ─────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=3000
