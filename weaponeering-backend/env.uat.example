# UAT / staging — ใช้สร้าง Kubernetes Secret (อย่าใช้ DB_HOST=pgpool จาก local Docker)
#
# kubectl -n weaponeering-backend-uat create secret generic weaponeering-backend-staging-secret \
#   --from-literal=DB_HOST='<pgpool-or-postgres-host-reachable-from-cluster>' \
#   --from-literal=DB_PORT='5432' \
#   --from-literal=DB_NAME='weaponeering' \
#   --from-literal=DB_USER='<user>' \
#   --from-literal=DB_PASSWORD='<password>' \
#   --from-literal=RTAF_MFA_URL='https://apigw.rtaf.mi.th/login-rtaf-mfa/v2/mfa/login' \
#   --from-literal=RTAF_MFA_TIMEOUT_SECONDS='15' \
#   --dry-run=client -o yaml | kubectl apply -f -
#
# ตรวจค่า (ไม่โชว์ password):
# kubectl -n weaponeering-backend-uat get secret weaponeering-backend-staging-secret -o jsonpath='{.data.DB_HOST}' | base64 -d; echo

DB_HOST=REPLACE_WITH_UAT_PGPOOL_HOST
DB_PORT=5432
DB_NAME=weaponeering
DB_USER=REPLACE_WITH_DB_USER
DB_PASSWORD=REPLACE_WITH_DB_PASSWORD

APP_NAME=Weaponeering API
API_PREFIX=/api
CORS_ORIGINS=https://weaponeering-uat.rtaf.mi.th

RTAF_MFA_URL=https://apigw.rtaf.mi.th/login-rtaf-mfa/v2/mfa/login
RTAF_MFA_TIMEOUT_SECONDS=15
